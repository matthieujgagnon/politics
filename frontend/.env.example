# Optional. Sent as part of the User-Agent header on requests to the public
# APIs this app depends on (Represent, Open Parliament, Wikidata) - several
# of them ask callers to identify themselves so operators can reach you if
# something's wrong.
CONTACT_EMAIL=

# Optional. Directory for the SQLite cache file (app.db). Defaults to
# ./.data next to wherever the app is run from - fine for local dev, but
# on a host with a mounted persistent disk (e.g. Render), set this to the
# disk's mount path so the cache survives deploys/restarts.
DB_DIR=
